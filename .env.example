# ─── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ─── Auth ──────────────────────────────────────────────────────────────────────
# Leave empty to run unauthenticated (fine for private Railway deployments)
# Set a strong random string to require x-api-key header on all /api/* requests
API_KEY=

# ─── Browser pool ──────────────────────────────────────────────────────────────
# Maximum simultaneous pages (each uses ~50-80 MB RAM)
MAX_CONCURRENT_PAGES=3

# Per-request timeout in ms (default: 30 seconds)
PAGE_TIMEOUT_MS=30000

# Idle browser shutdown — Chrome is killed after this many ms with no requests
# Set higher (e.g. 600000) if cold-starts are too slow for your workload
IDLE_BROWSER_TIMEOUT_MS=300000

# ─── Rate limiting ──────────────────────────────────────────────────────────────
MAX_REQUESTS_PER_MINUTE=30

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Set to your frontend domain in production, e.g. https://myapp.com
CORS_ORIGIN=*

# ─── Misc ──────────────────────────────────────────────────────────────────────
# Allow requests to localhost/private IPs (disable in production)
ALLOW_LOCALHOST=false

# Override Chromium path (leave blank to use Puppeteer's bundled Chrome)
# On Railway with nixpacks, this is set automatically
CHROMIUM_PATH=
